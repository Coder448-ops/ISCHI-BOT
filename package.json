{
  "name": "ischi-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Single-company industrial store: durable JSON backend, guest checkout and Capacitor Android",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "node scripts/start-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run build:mobile",
    "admin:hash": "node scripts/admin-hash.mjs",
    "build:mobile": "vite build",
    "mobile:sync": "npm run build:mobile && cap sync android",
    "mobile:assets": "npx --yes @capacitor/assets@4.0.0 generate --android",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx,css}\" \"lib/**/*.ts\" \"mobile/**/*.{ts,tsx,html}\" \"tests/**/*.ts\" \"e2e/**/*.ts\" \"scripts/*.mjs\" \"*.ts\" \"*.json\" \"docs/**/*.md\" \"README.md\" \".github/**/*.yml\""
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "proper-lockfile": "^4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.64.1",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^22.19.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "prettier": "^3.6.2"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.1"
  }
}
