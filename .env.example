# Server-only secrets. Never add NEXT_PUBLIC_ to credentials.
# Persistent disk directory. MUST be a mounted persistent volume in production.
DATA_DIR=./data
# Exact public website origin, e.g. https://shop.your-company.example
PUBLIC_WEB_ORIGIN=http://localhost:3000

# Administrator only. Use a strong unique password (12+ characters).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Preferred instead of plaintext password: output of npm run admin:hash
ADMIN_PASSWORD_HASH=

# Telegram bot credentials stay on the server.
TELEGRAM_BOT_TOKEN=
# Numeric chat ID preferred. Administrator must open the bot and press /start.
TELEGRAM_CHAT_ID=@Navroz0909

# Optional proxy mode. Set ONLY when this app is hosted somewhere without a durable
# disk (Vercel, Netlify, Cloud Run) and the JSON data lives on a persistent API server.
# The site then forwards /api/* to this origin and keeps no data itself.
# Leave empty for the normal single-server (Docker/VPS) setup.
# API_ORIGIN=https://api.your-company.example

# Optional: maximum JSON write lock wait is built in; no database configuration exists.
# Android build uses VITE_API_URL in a separate build environment, not this server file.
