# Server only. Never prefix these values with NEXT_PUBLIC_.
# Do not put real tokens/passwords in this tracked example file.

TELEGRAM_BOT_TOKEN=
# Use the administrator's numeric chat ID (preferred), or @Navroz0909.
# The administrator must first open the bot and press Start.
TELEGRAM_CHAT_ID=@Navroz0909

# Only the administrator signs in. Choose a unique, strong password (12+ characters).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# PostgreSQL connection string. Required on Vercel and for local development.
# Example: postgresql://user:password@host:5432/database?sslmode=require
# Vercel Postgres/Neon integrations may provide POSTGRES_URL instead; that is also accepted.
DATABASE_URL=
